{
  "$schema": "https://schema.railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @workspace/api-server build"
  },
  "deploy": {
    "startCommand": "cd artifacts/api-server && node --enable-source-maps ./dist/index.mjs",
    "restartPolicyType": "ON_FAILURE"
  }
}
